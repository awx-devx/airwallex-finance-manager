# Copy missing keys into ~/.hermes/.env (outside this clone).
# Do not commit filled values. This file is names only.
# install.sh sets FINANCE_MANAGER_ROOT for you.
#
# Airwallex is NOT configured here. AgentOS uses OAuth against the
# account you sign in with:
#   hermes mcp login airwallex
# Tokens land in ~/.hermes/mcp-tokens/ (not this file, not this repo).

# Absolute path to this clone
FINANCE_MANAGER_ROOT=

# Model provider — use the name your Hermes install expects
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Telegram (or run: hermes gateway setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Optional override; defaults to $FINANCE_MANAGER_ROOT/knowledge
# FINANCE_MANAGER_KNOWLEDGE_DIR=
